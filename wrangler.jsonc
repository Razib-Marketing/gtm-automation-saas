{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gtm-automation-saas",
  "main": "src/worker.ts",
  "compatibility_date": "2024-04-05",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "account_id": "9a5773f8872387b270ff94a8768ca0ee",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gtm_automation_d1",
      "database_id": "b3d530d4-aa76-4e71-8d29-b93fa2346656"
    }
  ],
  "triggers": {
    "crons": [
      "0 8 * * *"
    ]
  }
}
