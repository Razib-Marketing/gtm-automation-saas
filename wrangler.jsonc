{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gtm-automation-saas",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-24",
  "browser": {
    "binding": "BROWSER"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "gtmobserver.com", "custom_domain": true },
    { "pattern": "www.gtmobserver.com", "custom_domain": true },
    { "pattern": "app.gtmobserver.com", "custom_domain": true },
    { "pattern": "dashboard.gtmobserver.com", "custom_domain": true }
  ],
  "account_id": "e6935eeaed0033bef01efe59dd5b9337",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gtm_automation_d1",
      "database_id": "3e29a56f-8e68-4aa5-99c6-1b9a5677e2cd"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  }
}
